{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "poker-environment-identity/v1",
  "title": "Poker Engine environment identity",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "expected", "locks", "identity_sha256"],
  "properties": {
    "schema": {"const": "poker-environment-identity/v1"},
    "version": {"const": 1},
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "node", "playwright", "browser", "os"],
      "properties": {
        "python": {"$ref": "#/$defs/versionIdentity"},
        "node": {"$ref": "#/$defs/versionIdentity"},
        "playwright": {"$ref": "#/$defs/versionIdentity"},
        "browser": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1}
          }
        },
        "os": {
          "type": "object",
          "additionalProperties": false,
          "required": ["distribution", "version", "architecture"],
          "properties": {
            "distribution": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "architecture": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "locks": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "sha256"],
        "properties": {
          "role": {"enum": ["requirements_lock", "package_lock", "environment_lock", "os_lock"]},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_image",
        "definition",
        "container_lock_sha256",
        "system_packages_sha256",
        "container_manifest_sha256",
        "hermeticity_level",
        "base_image_pinned",
        "system_packages_fully_pinned"
      ],
      "properties": {
        "base_image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "tag", "platform", "digest", "architecture", "os"],
          "properties": {
            "repository": {"type": "string", "minLength": 1},
            "tag": {"type": "string", "minLength": 1},
            "platform": {"const": "linux/amd64"},
            "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "architecture": {"const": "x86_64"},
            "os": {
              "type": "object",
              "additionalProperties": false,
              "required": ["distribution", "version"],
              "properties": {
                "distribution": {"const": "ubuntu"},
                "version": {"const": "24.04"}
              }
            }
          }
        },
        "definition": {"$ref": "#/$defs/hashedPath"},
        "container_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "system_packages_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "container_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "hermeticity_level": {"type": "string", "minLength": 1},
        "base_image_pinned": {"const": true},
        "system_packages_fully_pinned": {"type": "boolean"}
      }
    },
    "identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "versionIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {"version": {"type": "string", "minLength": 1}}
    },
    "hashedPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}

{
  "schema": "poker-continuous-cycle/v1",
  "cycle": "2026-09-12",
  "promotion_mode": "disabled",
  "gate_report": "training/gates/20260912_report.json",
  "protected_production_paths": [
    "training/registry.json",
    "training/models",
    "training/runs/20260912_independent_profiles_v2/model",
    "user/releases",
    "site"
  ],
  "stages": [
    {
      "id": "dataset_increment_contract",
      "argv": ["python3", "tests/datasets/test_build_hand_history_increment.py"]
    },
    {
      "id": "persisted_snapshot_contract",
      "argv": ["python3", "tests/datasets/test_persisted_snapshot.py"]
    },
    {
      "id": "normalize_20260912_increment",
      "argv": [
        "python3", "tools/training/build_incremental_decisions_v2.py",
        "--source", "training/datasets/NLHE_100-200/increments/20260912/source/selected_100_200.zip",
        "--out", "/tmp/continuous-cycle-0912-decisions.jsonl",
        "--summary", "/tmp/continuous-cycle-0912-summary.json"
      ],
      "required_outputs": [
        "/tmp/continuous-cycle-0912-decisions.jsonl",
        "/tmp/continuous-cycle-0912-summary.json"
      ]
    },
    {
      "id": "build_model_a_overlay",
      "argv": [
        "python3", "tools/training/build_population_increment_overlay_v2.py",
        "--decisions", "/tmp/continuous-cycle-0912-decisions.jsonl",
        "--out", "/tmp/continuous-cycle-0912-overlay.json",
        "--provenance-out", "/tmp/continuous-cycle-0912-overlay-provenance.json"
      ],
      "required_outputs": [
        "/tmp/continuous-cycle-0912-overlay.json",
        "/tmp/continuous-cycle-0912-overlay-provenance.json"
      ]
    },
    {
      "id": "rebuild_model_a_preflop_candidate",
      "argv": [
        "python3", "tools/training/rebuild_preflop_increment_candidate.py",
        "--baseline", "training/models/preflop_population_model_v5.json",
        "--overlay", "/tmp/continuous-cycle-0912-overlay.json",
        "--decisions", "/tmp/continuous-cycle-0912-decisions.jsonl",
        "--date", "2026-09-12",
        "--source-label", "selected_100_200.zip",
        "--lineage-fingerprint", "9eb753baed592b48d697ad6d00652612de6153e5033448f41983bccc9e31be2b",
        "--out", "/tmp/continuous-cycle-0912-preflop-candidate.json"
      ],
      "required_outputs": ["/tmp/continuous-cycle-0912-preflop-candidate.json"]
    },
    {
      "id": "rebuild_model_a_postflop_candidate",
      "argv": [
        "python3", "tools/training/rebuild_postflop_increment_candidate.py",
        "--baseline", "training/models/postflop_population_model_v5.json",
        "--overlay", "/tmp/continuous-cycle-0912-overlay.json",
        "--decisions", "/tmp/continuous-cycle-0912-decisions.jsonl",
        "--date", "2026-09-12",
        "--source-label", "selected_100_200.zip",
        "--lineage-fingerprint", "9eb753baed592b48d697ad6d00652612de6153e5033448f41983bccc9e31be2b",
        "--model-version", "postflop_v6_20260912_full_weight_REJECTED",
        "--out", "/tmp/continuous-cycle-0912-postflop-candidate.json"
      ],
      "required_outputs": ["/tmp/continuous-cycle-0912-postflop-candidate.json"]
    },
    {
      "id": "recompute_unified_gate",
      "argv": [
        "python3", "tools/evaluate_promotion_gates.py",
        "--evidence", "training/gates/20260912_evidence.json",
        "--contract", "training/PROMOTION_GATE_CONTRACT.json",
        "--out", "/tmp/continuous-cycle-0912-gate.json",
        "--require-ready"
      ],
      "required_outputs": ["/tmp/continuous-cycle-0912-gate.json"]
    },
    {
      "id": "verify_gate_is_canonical",
      "argv": [
        "cmp", "/tmp/continuous-cycle-0912-gate.json", "training/gates/20260912_report.json"
      ]
    }
  ]
}

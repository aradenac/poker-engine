        "value": {
          "enum": [
            "FOLD",
            "CHECK",
            "CALL",
            "BET",
            "RAISE",
            "SHOVE",
            null
          ]
        }
      },
      "required": [
        "status",
        "value"
      ],
      "type": "object"
    },

    "action": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "SYNTHETIC_PLACEHOLDER"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "MEASURED"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "enum": [
                  "FOLD",
                  "CHECK",
                  "CALL",
                  "BET",
                  "RAISE",
                  "SHOVE"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "EXACT_DETERMINISTIC"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "const": "FOLD"
              }
            }
          }
        }
      ],
      "properties": {
        "status": {
          "enum": [
            "MEASURED",
            "EXACT_DETERMINISTIC",
            "SYNTHETIC_PLACEHOLDER"

{
  "$defs": {
    "alternativeSpec": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "FOLD",
            "CHECK",
            "CALL",
            "BET",
            "RAISE",
            "SHOVE"
          ]
        },
        "sizing": {
          "$ref": "#/$defs/sizingSpec"
        }
      },
      "required": [
        "action",
        "sizing"
      ],
      "type": "object"
    },
    "contentIdentity": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "minLength": 1,
          "type": "string"
        },
        "code_sha": {
          "pattern": "^[a-f0-9]{40}$",
          "type": "string"
        },
        "environment_identity_slot": {
          "minLength": 1,
          "type": "string"
        },
        "generation_id": {
          "minLength": 1,
          "type": "string"
        },
        "generation_parameters_slot": {
          "minLength": 1,
          "type": "string"
        },
        "generator_version": {
          "minLength": 1,
          "type": "string"
        },
        "population_id": {
          "minLength": 1,
          "type": "string"
        },
        "scientific_effect": {
          "minLength": 1,
          "type": "string"
        },
        "source_plan_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "source_train_audit_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "population_id",
        "generation_id",
        "candidate_id",
        "source_plan_sha256",
        "source_train_audit_sha256",
        "generator_version",
        "code_sha",
        "environment_identity_slot",
        "generation_parameters_slot",
        "scientific_effect"
      ],
      "type": "object"
    },
    "evidence": {
      "additionalProperties": false,
      "properties": {
        "ci95_high_bb": {
          "type": "number"
        },
        "ci95_low_bb": {
          "type": "number"
        },
        "ev_bb": {
          "type": "number"
        },
        "mode": {
          "enum": [
            "paired_adaptive",
            "paired_fixed"
          ]
        },
        "pairing_contract": {
          "const": "DECISION_SAMPLE_COMMON_RANDOM_NUMBERS_V1"
        },
        "rollout_budget_used": {
          "minimum": 0,
          "type": "integer"
        },
        "rollouts": {
          "minimum": 0,
          "type": "integer"
        },
        "samples": {
          "minimum": 0,
          "type": "integer"
        },
        "source_result_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "source_schema": {
          "const": "paired-adaptive-preflop-ev/v1"
        },
        "standard_error_bb": {
          "minimum": 0,
          "type": "number"
        },
        "worlds_materialized": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "source_schema",
        "source_result_sha256",
        "mode",
        "pairing_contract",
        "ev_bb",
        "samples",
        "rollouts",
        "worlds_materialized",
        "rollout_budget_used",
        "standard_error_bb",
        "ci95_low_bb",
        "ci95_high_bb"
      ],
      "type": "object"
    },
    "request": {
      "additionalProperties": false,
      "properties": {
        "alternatives": {
          "additionalProperties": {
            "$ref": "#/$defs/alternativeSpec"
          },
          "minProperties": 1,
          "type": "object"
        },
        "artifact_identity": {
          "$ref": "#/$defs/contentIdentity"
        },
        "decision_binding": {
          "additionalProperties": false,
          "properties": {
            "context_id": {
              "minLength": 1,
              "type": "string"
            },
            "decision_id": {
              "minLength": 1,
              "type": "string"
            },
            "hand_class": {
              "minLength": 2,
              "type": "string"
            }
          },
          "required": [
            "decision_id",
            "context_id",
            "hand_class"
          ],
          "type": "object"
        },
        "paired_result": {
          "type": "object"
        },
        "schema": {
          "const": "poker-paired-ev-generation-bridge-request/v1"
        }
      },
      "required": [
        "schema",
        "paired_result",
        "decision_binding",
        "artifact_identity",
        "alternatives"
      ],
      "type": "object"
    },
    "result": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "bridge_state": {
                "const": "EXACT_ZERO_ROLLOUT_NON_MATERIALIZABLE"
              }
            }
          },
          "then": {
            "properties": {
              "strategy_cell": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "bridge_state": {
                "const": "MEASURED_COMPATIBLE"
              }
            }
          },
          "then": {
            "properties": {
              "strategy_cell": {
                "$ref": "hero-preflop-strategy.schema.json#/$defs/cell"
              }
            }
          }
        }
      ],
      "properties": {
        "alternative_id": {
          "minLength": 1,
          "type": "string"
        },
        "bridge_state": {
          "enum": [
            "MEASURED_COMPATIBLE",
            "EXACT_ZERO_ROLLOUT_NON_MATERIALIZABLE"
          ]
        },
        "candidate_id": {
          "minLength": 1,
          "type": "string"
        },
        "code_sha": {
          "pattern": "^[a-f0-9]{40}$",
          "type": "string"
        },
        "context_id": {
          "minLength": 1,
          "type": "string"
        },
        "decision_id": {
          "minLength": 1,
          "type": "string"
        },
        "environment_identity_slot": {
          "minLength": 1,
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "exact_context": {
          "type": "object"
        },
        "exact_lookup": {
          "const": "EXACT_CONTEXT_ONLY"
        },
        "generation_id": {
          "minLength": 1,
          "type": "string"
        },
        "generation_parameters_slot": {
          "minLength": 1,
          "type": "string"
        },
        "generator_version": {
          "minLength": 1,
          "type": "string"
        },
        "hand_class": {
          "minLength": 2,
          "type": "string"
        },
        "nearest_context_allowed": {
          "const": false
        },
        "output_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "population_id": {
          "minLength": 1,
          "type": "string"
        },
        "schema": {
          "const": "poker-paired-ev-generation-bridge/v1"
        },
        "scientific_effect": {
          "const": "NONE_INTEGRATION_CONTRACT_ONLY"
        },
        "selected_alternative": {
          "$ref": "#/$defs/alternativeSpec"
        },
        "source_plan_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "source_train_audit_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "strategy_cell": {
          "oneOf": [
            {
              "$ref": "hero-preflop-strategy.schema.json#/$defs/cell"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema",
        "bridge_state",
        "scientific_effect",
        "exact_lookup",
        "nearest_context_allowed",
        "decision_id",
        "context_id",
        "hand_class",
        "alternative_id",
        "population_id",
        "generation_id",
        "candidate_id",
        "source_plan_sha256",
        "source_train_audit_sha256",
        "generator_version",
        "code_sha",
        "environment_identity_slot",
        "generation_parameters_slot",
        "exact_context",
        "selected_alternative",
        "evidence",
        "strategy_cell",
        "output_sha256"
      ],
      "type": "object"
    },
    "sizingSpec": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "NONE",
            "FIXED_BB",
            "POT_FRACTION",
            "ALL_IN"
          ]
        },
        "unit": {
          "enum": [
            "BB",
            "POT_FRACTION",
            null
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "value",
        "unit"
      ],
      "type": "object"
    }
  },
  "$id": "https://poker-engine.local/contracts/training/paired-ev-generation-bridge.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/result"
    }
  ],
  "title": "Paired/adaptive EV to Hero generation cell bridge"
}

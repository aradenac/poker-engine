{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model-b-preflop-sensitivity-harness-request/v1",
  "title": "Synthetic Model B preflop sensitivity harness request",
  "description": "Synthetic-only request contract for the #344 Model B preflop sensitivity harness. source_kind is additive: SYNTHETIC_HARNESS_ONLY is the unchanged default produced by project_canonical_decision(), and SYNTHETIC_ROBUSTNESS_PROJECTED is produced by project_robustness_input() from the #425 hero-model-b-robustness-input/v1 contract. Both remain synthetic: synthetic_fixture is pinned true, every information_boundary flag is pinned false, and a request that is not synthetic is rejected.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_kind",
    "synthetic_fixture",
    "decision_ref",
    "public_context",
    "alternatives",
    "information_boundary"
  ],
  "properties": {
    "schema": {
      "const": "model-b-preflop-sensitivity-harness-request/v1"
    },
    "source_kind": {
      "description": "Synthetic harness provenance. SYNTHETIC_HARNESS_ONLY is the default #314 canonical projection; SYNTHETIC_ROBUSTNESS_PROJECTED is the additive #425 consumer projection. Both are synthetic-only and neither may carry real #314/#367 evidence.",
      "enum": [
        "SYNTHETIC_HARNESS_ONLY",
        "SYNTHETIC_ROBUSTNESS_PROJECTED"
      ]
    },
    "synthetic_fixture": {
      "const": true
    },
    "decision_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_schema",
        "decision_id",
        "context_id"
      ],
      "properties": {
        "canonical_schema": {
          "const": "poker-preflop-decision/v1"
        },
        "decision_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "context_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "public_context": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "synthetic_fixture",
        "hero_position",
        "hero_contribution_before_bb",
        "pot_before_hero_action_bb",
        "initial_sequence",
        "limper_count",
        "responders"
      ],
      "properties": {
        "synthetic_fixture": {
          "const": true
        },
        "hero_position": {
          "type": "string",
          "minLength": 1
        },
        "hero_contribution_before_bb": {
          "type": "number",
          "minimum": 0
        },
        "pot_before_hero_action_bb": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "limper_count": {
          "type": "integer",
          "minimum": 0
        },
        "initial_sequence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "position",
              "action"
            ],
            "properties": {
              "position": {
                "type": "string"
              },
              "action": {
                "type": "string"
              }
            }
          }
        },
        "responders": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "position",
              "profile",
              "contribution_bb",
              "effective_stack_bb",
              "family_no_callers",
              "family_with_callers"
            ],
            "properties": {
              "position": {
                "type": "string",
                "minLength": 1
              },
              "profile": {
                "type": [
                  "integer",
                  "string"
                ]
              },
              "contribution_bb": {
                "type": "number",
                "minimum": 0
              },
              "effective_stack_bb": {
                "type": "number",
                "minimum": 0
              },
              "family_no_callers": {
                "type": "string",
                "minLength": 1
              },
              "family_with_callers": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "alternatives": {
      "description": "Candidate Hero alternatives as public action+sizing identity only. A #425 robustness-shaped alternative loses its ev_bb, uncertainty, route, source, paired_delta_vs_best_bb, support and posterior_refs before it reaches this contract.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alternative_id",
          "action",
          "target_total_bb",
          "incremental_cost_bb"
        ],
        "properties": {
          "alternative_id": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "enum": [
              "FOLD",
              "OVERLIMP",
              "ISO"
            ]
          },
          "target_total_bb": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "incremental_cost_bb": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "information_boundary": {
      "description": "Hard boundary of the harness request: every flag is pinned false, so no Hero EV, Model A signal, recommendation or private information may enter the sensitivity run.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hero_ev_consumed",
        "model_a_consumed",
        "recommendation_consumed",
        "future_cards_consumed",
        "opponent_hole_cards_consumed"
      ],
      "properties": {
        "hero_ev_consumed": {
          "const": false
        },
        "model_a_consumed": {
          "const": false
        },
        "recommendation_consumed": {
          "const": false
        },
        "future_cards_consumed": {
          "const": false
        },
        "opponent_hole_cards_consumed": {
          "const": false
        }
      }
    }
  }
}

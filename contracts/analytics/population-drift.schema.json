{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://poker-engine.local/contracts/analytics/population-drift.schema.json",
  "title":"Population drift report",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "schema","config_schema","population_id","state","comparable","reason_codes",
    "baseline_cohort","target_cohort","scope","config","cells","ranking","semantics","report_hash"
  ],
  "properties":{
    "schema":{"const":"poker-population-drift/v1"},
    "config_schema":{"const":"poker-population-drift-config/v1"},
    "population_id":{"type":"string","minLength":1},
    "state":{"enum":["STABLE","DRIFTED","LOW_SUPPORT","NOT_COMPARABLE"]},
    "comparable":{"type":"boolean"},
    "reason_codes":{"type":"array","items":{"type":"string"}},
    "baseline_cohort":{"$ref":"#/$defs/cohort"},
    "target_cohort":{"$ref":"#/$defs/cohort"},
    "scope":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/scope"}]},
    "config":{"$ref":"#/$defs/config"},
    "cells":{"type":"array","items":{"$ref":"#/$defs/cell"}},
    "ranking":{"type":"array","items":{"$ref":"#/$defs/ranking"}},
    "summary":{"type":"object"},
    "semantics":{"$ref":"#/$defs/semantics"},
    "report_hash":{"type":"string","pattern":"^population-drift-report:"}
  },
  "$defs":{
    "cohort":{
      "type":"object","additionalProperties":false,
      "required":["cohort_id","source","split","window","hand_count","decision_count","dataset_fingerprint","source_fingerprint","normalized_fingerprint"],
      "properties":{
        "cohort_id":{"type":"string"},"source":{"type":"string","minLength":1},"split":{"type":"string","minLength":1},
        "window":{"oneOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["start","end"],"properties":{"start":{"type":["string","null"]},"end":{"type":["string","null"]}}}]},
        "hand_count":{"type":"integer","minimum":0},"decision_count":{"type":"integer","minimum":0},
        "dataset_fingerprint":{"type":"string","minLength":1},"source_fingerprint":{"type":"string","minLength":1},
        "normalized_fingerprint":{"type":"string","minLength":1}
      }
    },
    "scope":{
      "type":"object","additionalProperties":false,
      "required":["population_id","pack_id","strategy_id","strategy_version","ev_reference"],
      "properties":{
        "population_id":{"type":"string"},"pack_id":{"type":["string","null"]},
        "strategy_id":{"type":"string"},"strategy_version":{"type":"string"},"ev_reference":{"type":"string"}
      }
    },
    "config":{
      "type":"object","additionalProperties":false,
      "required":[
        "schema","minimum_decisions_per_cohort","minimum_distinct_hands_per_cohort",
        "minimum_supported_decisions_per_cohort","minimum_supported_ratio",
        "absolute_frequency_delta_threshold","relative_frequency_delta_threshold",
        "relative_delta_min_baseline_frequency","js_divergence_threshold","sizing_js_divergence_threshold",
        "bootstrap_min_decisions_per_cohort","bootstrap_iterations","bootstrap_confidence","bootstrap_seed","sizing_buckets"
      ],
      "properties":{
        "schema":{"const":"poker-population-drift-config/v1"},
        "minimum_decisions_per_cohort":{"type":"integer","minimum":1},
        "minimum_distinct_hands_per_cohort":{"type":"integer","minimum":1},
        "minimum_supported_decisions_per_cohort":{"type":"integer","minimum":0},
        "minimum_supported_ratio":{"type":"number","minimum":0,"maximum":1},
        "absolute_frequency_delta_threshold":{"type":"number","minimum":0,"maximum":1},
        "relative_frequency_delta_threshold":{"type":"number","minimum":0},
        "relative_delta_min_baseline_frequency":{"type":"number","minimum":0,"maximum":1},
        "js_divergence_threshold":{"type":"number","minimum":0,"maximum":1},
        "sizing_js_divergence_threshold":{"type":"number","minimum":0,"maximum":1},
        "bootstrap_min_decisions_per_cohort":{"type":"integer","minimum":1},
        "bootstrap_iterations":{"type":"integer","minimum":1},
        "bootstrap_confidence":{"type":"number","exclusiveMinimum":0,"exclusiveMaximum":1},
        "bootstrap_seed":{"type":"string","minLength":1},
        "sizing_buckets":{
          "type":"object","additionalProperties":false,"required":["pot_ratio_edges","target_bb_edges"],
          "properties":{
            "pot_ratio_edges":{"type":"array","items":{"type":"number"},"minItems":3},
            "target_bb_edges":{"type":"array","items":{"type":"number"},"minItems":1}
          }
        }
      }
    },
    "source_ref":{
      "type":"object","additionalProperties":false,"required":["hand_id","decision_id"],
      "properties":{"hand_id":{"type":"string"},"decision_id":{"type":"string"}}
    },
    "support":{
      "type":"object","additionalProperties":false,
      "required":["hand_count","decision_count","distinct_hands","supported_decision_count","supported_ratio","minimum_event_support_observations","source_refs"],
      "properties":{
        "hand_count":{"type":"integer","minimum":0},"decision_count":{"type":"integer","minimum":0},
        "distinct_hands":{"type":"array","items":{"type":"string"}},
        "supported_decision_count":{"type":"integer","minimum":0},"supported_ratio":{"type":["number","null"],"minimum":0,"maximum":1},
        "minimum_event_support_observations":{"type":["integer","null"],"minimum":0},
        "source_refs":{"type":"array","items":{"$ref":"#/$defs/source_ref"}}
      }
    },
    "metric":{
      "type":"object","additionalProperties":false,
      "required":["baseline","target","delta","absolute_delta","relative_delta"],
      "properties":{
        "baseline":{"type":"number"},"target":{"type":"number"},"delta":{"type":"number"},"absolute_delta":{"type":"number"},
        "relative_delta":{"type":["number","null"]}
      }
    },
    "cell":{
      "type":"object","additionalProperties":false,
      "required":["schema","cell_id","dimension","key","state","baseline","target","metrics","sizing_distribution","distance","support","uncertainty","drift_reason_codes","primary_change","semantics"],
      "properties":{
        "schema":{"const":"poker-population-drift-cell/v1"},"cell_id":{"type":"string"},"dimension":{"enum":["position","street","spot_family","action","sizing_bucket","jam","overbet","preflop_family","preflop_context"]},
        "key":{"type":"string"},"state":{"enum":["STABLE","DRIFTED","LOW_SUPPORT"]},
        "baseline":{"$ref":"#/$defs/support"},"target":{"$ref":"#/$defs/support"},
        "metrics":{
          "type":"object","additionalProperties":false,
          "required":["fold_frequency","call_frequency","raise_frequency","jam_frequency","overbet_frequency"],
          "properties":{
            "fold_frequency":{"$ref":"#/$defs/metric"},"call_frequency":{"$ref":"#/$defs/metric"},
            "raise_frequency":{"$ref":"#/$defs/metric"},"jam_frequency":{"$ref":"#/$defs/metric"},"overbet_frequency":{"$ref":"#/$defs/metric"}
          }
        },
        "sizing_distribution":{"type":"object"},
        "distance":{
          "type":"object","additionalProperties":false,
          "required":["action_js_divergence","sizing_js_divergence","jam_js_divergence","overbet_js_divergence","composite_distance"],
          "properties":{
            "action_js_divergence":{"type":"number","minimum":0,"maximum":1},"sizing_js_divergence":{"type":"number","minimum":0,"maximum":1},
            "jam_js_divergence":{"type":"number","minimum":0,"maximum":1},"overbet_js_divergence":{"type":"number","minimum":0,"maximum":1},
            "composite_distance":{"type":"number","minimum":0,"maximum":1}
          }
        },
        "support":{"type":"object"},"uncertainty":{"type":"object"},"drift_reason_codes":{"type":"array","items":{"type":"string"}},
        "primary_change":{"type":"object"},"semantics":{"$ref":"#/$defs/cell_semantics"}
      }
    },
    "ranking":{
      "type":"object","additionalProperties":false,
      "required":["cell_id","dimension","context","state","metric","baseline_value","target_value","delta","distance","support","source_refs","impact_score"],
      "properties":{
        "cell_id":{"type":"string"},"dimension":{"type":"string"},"context":{"type":"string"},"state":{"const":"DRIFTED"},"metric":{"type":"string"},
        "baseline_value":{"type":["number","null"]},"target_value":{"type":["number","null"]},"delta":{"type":["number","null"]},
        "distance":{"type":"number"},"support":{"type":"object"},"source_refs":{"type":"object"},"impact_score":{"type":"number"}
      }
    },
    "cell_semantics":{
      "type":"object","additionalProperties":false,
      "required":["descriptive_only","retrain_recommended","promotion_recommended","model_change_recommended"],
      "properties":{"descriptive_only":{"const":true},"retrain_recommended":{"const":false},"promotion_recommended":{"const":false},"model_change_recommended":{"const":false}}
    },
    "semantics":{
      "type":"object","additionalProperties":false,
      "required":["descriptive_only","test_consumed","prospective_evaluation","ev_metrics_consumed","retrain_recommended","promotion_recommended","model_change_recommended"],
      "properties":{
        "descriptive_only":{"const":true},"test_consumed":{"const":false},"prospective_evaluation":{"const":false},"ev_metrics_consumed":{"const":false},
        "retrain_recommended":{"const":false},"promotion_recommended":{"const":false},"model_change_recommended":{"const":false}
      }
    }
  }
}

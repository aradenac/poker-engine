{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://poker-engine.local/contracts/analytics/hero-recommendation-distribution.schema.json",
  "title":"Hero recommendation distribution audit",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","config_schema","identity","config","exposure","distributions","segments","aggressive_tail_ranking","source_refs","semantics","report_hash"],
  "properties":{
    "schema":{"const":"poker-hero-recommendation-distribution/v1"},
    "config_schema":{"const":"poker-hero-recommendation-distribution-config/v1"},
    "identity":{"$ref":"#/$defs/identity"},
    "config":{"$ref":"#/$defs/config"},
    "exposure":{"$ref":"#/$defs/exposure"},
    "distributions":{"$ref":"#/$defs/views"},
    "segments":{"type":"array","items":{"$ref":"#/$defs/segment"}},
    "aggressive_tail_ranking":{"type":"array","items":{"$ref":"#/$defs/ranking"}},
    "source_refs":{"type":"array","items":{"$ref":"#/$defs/source_ref"}},
    "semantics":{
      "type":"object","additionalProperties":false,
      "required":["descriptive_only","support_coverage_separate_from_distribution","fail_closed_counted_as_recommendation","test_consumed","issue_108_consumed","optimization_performed","promotion_performed","strategy_modified","automatic_aggressiveness_verdict","ev_metrics_consumed"],
      "properties":{
        "descriptive_only":{"const":true},
        "support_coverage_separate_from_distribution":{"const":true},
        "fail_closed_counted_as_recommendation":{"const":false},
        "test_consumed":{"const":false},
        "issue_108_consumed":{"const":false},
        "optimization_performed":{"const":false},
        "promotion_performed":{"const":false},
        "strategy_modified":{"const":false},
        "automatic_aggressiveness_verdict":{"const":false},
        "ev_metrics_consumed":{"const":false}
      }
    },
    "report_hash":{"type":"string","pattern":"^hero-recommendation-distribution:"}
  },
  "$defs":{
    "identity":{
      "type":"object","additionalProperties":false,
      "required":["population_id","pack_id","pack_version","strategy_id","strategy_version","ev_reference"],
      "properties":{
        "population_id":{"type":"string","minLength":1},"pack_id":{"type":["string","null"]},"pack_version":{"type":["string","null"]},
        "strategy_id":{"type":"string","minLength":1},"strategy_version":{"type":"string","minLength":1},"ev_reference":{"type":"string","minLength":1}
      }
    },
    "config":{
      "type":"object","additionalProperties":false,
      "required":["schema","supported_tiers","large_sizing_pot_ratio","large_sizing_target_bb","sizing_buckets","ranking_limit"],
      "properties":{
        "schema":{"const":"poker-hero-recommendation-distribution-config/v1"},
        "supported_tiers":{"type":"array","items":{"type":"string"},"minItems":1},
        "large_sizing_pot_ratio":{"type":"number","minimum":0},
        "large_sizing_target_bb":{"type":"number","minimum":0},
        "sizing_buckets":{
          "type":"object","additionalProperties":false,"required":["pot_ratio_edges","target_bb_edges"],
          "properties":{
            "pot_ratio_edges":{"type":"array","items":{"type":"number"},"minItems":1},
            "target_bb_edges":{"type":"array","items":{"type":"number"},"minItems":1}
          }
        },
        "ranking_limit":{"type":"integer","minimum":1}
      }
    },
    "source_ref":{
      "type":"object","additionalProperties":false,"required":["hand_id","decision_id"],
      "properties":{"hand_id":{"type":"string"},"decision_id":{"type":"string"}}
    },
    "exposure":{
      "type":"object","additionalProperties":false,
      "required":["input_decisions","admissible_recommendations","fail_closed_decisions","uncovered_admissible_decisions","low_support_admissible_decisions","supported_recommendations","weighted_recommendations","admissible_ratio","supported_ratio","weighted_coverage_ratio","fail_closed_reasons","coverage_states","support_tiers"],
      "properties":{
        "input_decisions":{"type":"integer","minimum":0},"admissible_recommendations":{"type":"integer","minimum":0},"fail_closed_decisions":{"type":"integer","minimum":0},
        "uncovered_admissible_decisions":{"type":"integer","minimum":0},"low_support_admissible_decisions":{"type":"integer","minimum":0},
        "supported_recommendations":{"type":"integer","minimum":0},"weighted_recommendations":{"type":"integer","minimum":0},
        "admissible_ratio":{"type":["number","null"],"minimum":0,"maximum":1},"supported_ratio":{"type":["number","null"],"minimum":0,"maximum":1},
        "weighted_coverage_ratio":{"type":["number","null"],"minimum":0,"maximum":1},
        "fail_closed_reasons":{"type":"object","additionalProperties":{"type":"integer","minimum":0}},
        "coverage_states":{"type":"object","additionalProperties":{"type":"integer","minimum":0}},
        "support_tiers":{"type":"object","additionalProperties":{"type":"integer","minimum":0}}
      }
    },
    "action_row":{
      "type":"object","additionalProperties":false,"required":["count","frequency"],
      "properties":{"count":{"type":"number","minimum":0},"frequency":{"type":"number","minimum":0,"maximum":1}}
    },
    "view":{
      "type":"object","additionalProperties":false,
      "required":["recommendation_count","action_distribution","sizing_distribution","tails","played_comparison","source_refs"],
      "properties":{
        "recommendation_count":{"type":"integer","minimum":0},
        "action_distribution":{"type":"object"},
        "sizing_distribution":{"type":"object"},
        "tails":{"type":"object"},
        "played_comparison":{"type":"object"},
        "source_refs":{"type":"array","items":{"$ref":"#/$defs/source_ref"}}
      }
    },
    "views":{
      "type":"object","additionalProperties":false,"required":["raw","supported","observed_frequency_weighted"],
      "properties":{"raw":{"$ref":"#/$defs/view"},"supported":{"$ref":"#/$defs/view"},"observed_frequency_weighted":{"$ref":"#/$defs/view"}}
    },
    "segment":{
      "type":"object","additionalProperties":false,
      "required":["segment_id","dimension","key","exposure","distributions","source_refs"],
      "properties":{
        "segment_id":{"type":"string"},
        "dimension":{"enum":["street","position","spot_family","context","support"]},
        "key":{"type":"string"},"exposure":{"$ref":"#/$defs/exposure"},"distributions":{"$ref":"#/$defs/views"},
        "source_refs":{"type":"array","items":{"$ref":"#/$defs/source_ref"}}
      }
    },
    "ranking":{
      "type":"object","additionalProperties":false,
      "required":["context","decision_count","jam_count","overbet_count","large_sizing_count","aggressive_tail_events","aggressive_tail_decision_count","weighted_tail_share","source_refs"],
      "properties":{
        "context":{"type":"object"},"decision_count":{"type":"integer","minimum":1},"jam_count":{"type":"integer","minimum":0},
        "overbet_count":{"type":"integer","minimum":0},"large_sizing_count":{"type":"integer","minimum":0},
        "aggressive_tail_events":{"type":"integer","minimum":1},"aggressive_tail_decision_count":{"type":"integer","minimum":1},
        "weighted_tail_share":{"type":["number","null"],"minimum":0,"maximum":1},
        "source_refs":{"type":"array","items":{"$ref":"#/$defs/source_ref"}}
      }
    }
  }
}

{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://poker-engine.local/contracts/analytics/prospective-report.schema.json",
  "title":"Preparatory prospective analytics report",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "schema","protocol_schema","holdout_schema","holdout_id","generation","holdout_state","population_id",
    "candidate_identity","prospective_cohort","protocol_validation","sections","protocol_classification",
    "source_refs","strategic_verdict","semantics","report_id"
  ],
  "properties":{
    "schema":{"const":"poker-prospective-analytics-report/v1"},
    "protocol_schema":{"const":"poker-prospective-holdout-protocol/v1"},
    "holdout_schema":{"const":"poker-prospective-holdout/v1"},
    "holdout_id":{"type":"string","minLength":1},
    "generation":{"type":"integer","minimum":1},
    "holdout_state":{"enum":["UNCONSUMED","EVALUATING"]},
    "population_id":{"type":"string","minLength":1},
    "candidate_identity":{"$ref":"#/$defs/candidate"},
    "prospective_cohort":{"$ref":"#/$defs/cohort"},
    "protocol_validation":{
      "type":"object","additionalProperties":false,
      "required":["schema","status","manifest_sha256","hand_count"],
      "properties":{
        "schema":{"const":"poker-prospective-holdout-report/v1"},"status":{"const":"PASS"},
        "manifest_sha256":{"type":"string","minLength":1},"hand_count":{"type":"integer","minimum":0}
      }
    },
    "sections":{
      "type":"object","additionalProperties":false,
      "required":["population_drift","coverage","model_calibration","strategy_performance"],
      "properties":{
        "population_drift":{"$ref":"#/$defs/section"},"coverage":{"$ref":"#/$defs/section"},
        "model_calibration":{"$ref":"#/$defs/section"},"strategy_performance":{"$ref":"#/$defs/section"}
      }
    },
    "protocol_classification":{
      "type":"object","additionalProperties":false,
      "required":["population_drift","coverage","performance"],
      "properties":{
        "population_drift":{"$ref":"#/$defs/classification"},"coverage":{"$ref":"#/$defs/classification"},"performance":{"$ref":"#/$defs/classification"}
      }
    },
    "source_refs":{"type":"array","items":{"$ref":"#/$defs/source_ref"}},
    "strategic_verdict":{"type":"null"},
    "semantics":{
      "type":"object","additionalProperties":false,
      "required":["descriptive_only","test_consumed","prospective_evaluation","thresholds_modified","promotion_performed","strategy_modified","model_pointer_modified"],
      "properties":{
        "descriptive_only":{"const":true},"test_consumed":{"const":false},"prospective_evaluation":{"const":false},
        "thresholds_modified":{"const":false},"promotion_performed":{"const":false},
        "strategy_modified":{"const":false},"model_pointer_modified":{"const":false}
      }
    },
    "report_id":{"type":"string","pattern":"^prospective-analytics:"}
  },
  "$defs":{
    "classification":{"enum":["PASS","WARN","FAIL","INCONCLUSIVE","NOT_EVALUATED"]},
    "source_ref":{
      "type":"object","additionalProperties":false,"required":["hand_id","decision_id"],
      "properties":{"hand_id":{"type":"string"},"decision_id":{"type":"string"}}
    },
    "candidate":{
      "type":"object","additionalProperties":false,
      "required":["population_id","candidate_id","candidate_artifact_sha256","pack_sha256","strategy_sha256","models","metrics_sha256","thresholds_sha256","protocol_sha256","source_commit_sha","frozen_at"],
      "properties":{
        "population_id":{"type":"string"},"candidate_id":{"type":"string"},"candidate_artifact_sha256":{"type":"string"},
        "pack_sha256":{"type":"string"},"strategy_sha256":{"type":"string"},"models":{"type":"object"},
        "metrics_sha256":{"type":"string"},"thresholds_sha256":{"type":"string"},"protocol_sha256":{"type":"string"},
        "source_commit_sha":{"type":"string"},"frozen_at":{"type":"string"}
      }
    },
    "cohort":{
      "type":"object","additionalProperties":false,
      "required":["holdout_id","generation","population_id","manifest_sha256","dataset_fingerprint","source_fingerprint","hand_count","decision_count","split"],
      "properties":{
        "holdout_id":{"type":"string"},"generation":{"type":"integer","minimum":1},"population_id":{"type":"string"},
        "manifest_sha256":{"type":"string"},"dataset_fingerprint":{"type":"string"},"source_fingerprint":{"type":"string"},
        "hand_count":{"type":"integer","minimum":0},"decision_count":{"type":"integer","minimum":0},"split":{"type":"string"}
      }
    },
    "section":{
      "type":"object","additionalProperties":false,
      "required":["schema","name","state","protocol_classification","evidence_schema","evidence_fingerprint","summary","source_refs","reason_codes","semantics"],
      "properties":{
        "schema":{"const":"poker-prospective-analytics-section/v1"},
        "name":{"enum":["population_drift","coverage","model_calibration","strategy_performance"]},
        "state":{"enum":["NOT_EVALUATED","INSUFFICIENT_SUPPORT","DRIFT","NO_DRIFT","COVERAGE_GAP","COVERED","PERFORMANCE_RESULT"]},
        "protocol_classification":{"$ref":"#/$defs/classification"},
        "evidence_schema":{"type":["string","null"]},"evidence_fingerprint":{"type":["string","null"]},
        "summary":{"type":["object","null"]},"source_refs":{"type":"array","items":{"$ref":"#/$defs/source_ref"}},
        "reason_codes":{"type":"array","items":{"type":"string"}},
        "semantics":{
          "type":"object","additionalProperties":false,"required":["descriptive_only","strategic_verdict"],
          "properties":{"descriptive_only":{"const":true},"strategic_verdict":{"type":"null"}}
        }
      }
    }
  }
}

{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://poker-engine.local/contracts/analytics/recommendation-consistency.schema.json",
  "title":"Recommendation action/sizing/EV consistency audit",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","policy_schema","policy","identity","summary","decisions","violations","source_refs","semantics","report_hash"],
  "properties":{
    "schema":{"const":"poker-recommendation-consistency-report/v1"},
    "policy_schema":{"const":"poker-recommendation-consistency-policy/v1"},
    "policy":{"$ref":"#/$defs/policy"},
    "identity":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/identity"}]},
    "summary":{"type":"object"},
    "decisions":{"type":"array","items":{"$ref":"#/$defs/decision"}},
    "violations":{
      "type":"object","additionalProperties":false,
      "required":["by_type","by_street","by_spot_family","by_context"],
      "properties":{
        "by_type":{"type":"array","items":{"$ref":"#/$defs/aggregate"}},
        "by_street":{"type":"array","items":{"$ref":"#/$defs/aggregate"}},
        "by_spot_family":{"type":"array","items":{"$ref":"#/$defs/aggregate"}},
        "by_context":{"type":"array","items":{"$ref":"#/$defs/aggregate"}}
      }
    },
    "source_refs":{"type":"array","items":{"$ref":"#/$defs/source_ref"}},
    "semantics":{
      "type":"object","additionalProperties":false,
      "required":["validation_only","scientific_effect","test_consumed","issue_108_consumed","optimization_performed","promotion_performed","strategy_mutated","central_ui_modified"],
      "properties":{
        "validation_only":{"const":true},"scientific_effect":{"const":"NONE_VALIDATION_ONLY"},
        "test_consumed":{"const":false},"issue_108_consumed":{"const":false},
        "optimization_performed":{"const":false},"promotion_performed":{"const":false},
        "strategy_mutated":{"const":false},"central_ui_modified":{"const":false}
      }
    },
    "report_hash":{"type":"string","pattern":"^recommendation-consistency:"}
  },
  "$defs":{
    "policy":{
      "type":"object","additionalProperties":false,
      "required":["schema","ev_tolerance_bb","numeric_tolerance_bb","within_noise_standard_error_multiplier","tie_break","comparable_only_for_max_ev","fail_closed_requires_null_recommendation"],
      "properties":{
        "schema":{"const":"poker-recommendation-consistency-policy/v1"},
        "ev_tolerance_bb":{"type":"number","minimum":0},"numeric_tolerance_bb":{"type":"number","minimum":0},
        "within_noise_standard_error_multiplier":{"type":"number","minimum":0},
        "tie_break":{"const":"ALTERNATIVE_ID_ASC"},
        "comparable_only_for_max_ev":{"const":true},
        "fail_closed_requires_null_recommendation":{"const":true}
      }
    },
    "identity":{
      "type":"object","additionalProperties":false,
      "required":["population_id","pack_id","pack_version","strategy_id","strategy_version","strategy_sha256","decision_source_sha256","ev_reference"],
      "properties":{
        "population_id":{"type":"string"},"pack_id":{"type":["string","null"]},"pack_version":{"type":["string","null"]},
        "strategy_id":{"type":"string"},"strategy_version":{"type":"string"},
        "strategy_sha256":{"type":["string","null"]},"decision_source_sha256":{"type":["string","null"]},"ev_reference":{"type":"string"}
      }
    },
    "source_ref":{
      "type":"object","additionalProperties":false,"required":["hand_id","decision_id"],
      "properties":{"hand_id":{"type":["string","null"]},"decision_id":{"type":"string"}}
    },
    "finding":{
      "type":"object","additionalProperties":false,
      "required":["type","certainty","message","details"],
      "properties":{
        "type":{"enum":["ACTION_EV_MISMATCH","SIZING_EV_MISMATCH","RECOMMENDED_EV_MISMATCH","NON_MAX_EV_RECOMMENDATION","SURFACE_DIVERGENCE","INCREMENTAL_COST_MISMATCH","IDENTITY_MISMATCH","FAIL_CLOSED_RECOMMENDATION_PRESENT","TIE_POLICY_MISMATCH","SELECTED_ALTERNATIVE_MISSING"]},
        "certainty":{"enum":["CERTAIN","WITHIN_NOISE","NOT_COMPARABLE"]},
        "message":{"type":"string"},"details":{"type":"object"}
      }
    },
    "decision":{
      "type":"object","additionalProperties":false,
      "required":["schema","decision_id","hand_id","status","street","spot_family","context_id","identity","recommendation_admissible","recommendation_tuple","selected_alternative_id","tie_policy","surface_parity","violations","counts","source_refs","semantics"],
      "properties":{
        "schema":{"const":"poker-recommendation-consistency-decision/v1"},
        "decision_id":{"type":"string"},"hand_id":{"type":["string","null"]},
        "status":{"enum":["PASS","FAIL","INCONCLUSIVE"]},"street":{"type":"string"},"spot_family":{"type":"string"},"context_id":{"type":["string","null"]},
        "identity":{"$ref":"#/$defs/identity"},"recommendation_admissible":{"type":"boolean"},
        "recommendation_tuple":{"type":"object"},"selected_alternative_id":{"type":["string","null"]},
        "tie_policy":{"type":"object"},"surface_parity":{"type":"object"},
        "violations":{"type":"array","items":{"$ref":"#/$defs/finding"}},"counts":{"type":"object"},
        "source_refs":{"type":"array","items":{"$ref":"#/$defs/source_ref"}},"semantics":{"type":"object"}
      }
    },
    "aggregate":{
      "type":"object","additionalProperties":false,"required":["key","count","decision_count","source_refs"],
      "properties":{"key":{"type":"string"},"count":{"type":"integer","minimum":1},"decision_count":{"type":"integer","minimum":1},"source_refs":{"type":"array","items":{"$ref":"#/$defs/source_ref"}}}
    }
  }
}
